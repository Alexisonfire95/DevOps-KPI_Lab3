{
	"name": "devops-kpi",
	"version": "1.0.0",
	"description": "Task Tracker (mywebapp) — DevOps KPI Lab 1",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"start": "node src/index.js",
		"migrate": "node src/migrate.js",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"lint:docker": "hadolint Dockerfile",
		"lint:shell": "shellcheck scripts/*.sh deploy/*.sh",
		"test": "node --test \"tests/unit/*.test.js\" \"tests/integration/index.js\"",
		"test:unit": "node --test \"tests/unit/*.test.js\"",
		"test:integration": "node --test \"tests/integration/index.js\"",
		"test:coverage": "c8 --check-coverage --lines 40 --reporter=text --reporter=html node --test \"tests/unit/*.test.js\" \"tests/integration/index.js\""
	},
	"dependencies": {
		"pg": "^8.16.0",
		"yaml": "^2.8.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"c8": "^11.0.0",
		"eslint": "^10.4.0",
		"testcontainers": "^12.0.1"
	}
}
